<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:StemCode.Desktop.Controls">

    <Styles.Resources>
        <!-- Surfaces -->
        <SolidColorBrush x:Key="AppBackground" Color="#0E0E10"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="#131315"/>
        <SolidColorBrush x:Key="SurfaceBackground" Color="#18181B"/>
        <SolidColorBrush x:Key="SurfaceRaised" Color="#1E1E22"/>
        <SolidColorBrush x:Key="SurfaceHover" Color="#232327"/>
        <SolidColorBrush x:Key="SurfaceSunken" Color="#0A0A0B"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#232326"/>
        <SolidColorBrush x:Key="BorderDefault" Color="#2E2E33"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#3F3F46"/>
        <!-- Text -->
        <SolidColorBrush x:Key="TextPrimary" Color="#ECECEE"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="TextMuted" Color="#71717A"/>
        <!-- Accents -->
        <SolidColorBrush x:Key="Accent" Color="#E2875A"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#2A1B14"/>
        <SolidColorBrush x:Key="Info" Color="#7AA2F7"/>
        <SolidColorBrush x:Key="Success" Color="#4ADE80"/>
        <SolidColorBrush x:Key="Warning" Color="#FBBF24"/>
        <SolidColorBrush x:Key="Danger" Color="#F87171"/>
        <SolidColorBrush x:Key="DangerSoft" Color="#2A1415"/>
        <SolidColorBrush x:Key="UserBubble" Color="#232327"/>

        <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, JetBrains Mono, Menlo, monospace</FontFamily>

        <!-- 24x24 stroke icons -->
        <StreamGeometry x:Key="IconPlus">M12 5 L12 19 M5 12 L19 12</StreamGeometry>
        <StreamGeometry x:Key="IconSend">M12 19 L12 5 M6 11 L12 5 L18 11</StreamGeometry>
        <StreamGeometry x:Key="IconStop">M7 7 L17 7 L17 17 L7 17 Z</StreamGeometry>
        <StreamGeometry x:Key="IconMic">M12 3 C10.3 3 9 4.3 9 6 L9 12 C9 13.7 10.3 15 12 15 C13.7 15 15 13.7 15 12 L15 6 C15 4.3 13.7 3 12 3 Z M5 11 C5 14.9 8.1 18 12 18 C15.9 18 19 14.9 19 11 M12 18 L12 21</StreamGeometry>
        <StreamGeometry x:Key="IconPaperclip">M20 11.5 L12.2 19.3 C10.2 21.3 7 21.3 5 19.3 C3 17.3 3 14.1 5 12.1 L12.8 4.3 C14.2 2.9 16.4 2.9 17.8 4.3 C19.2 5.7 19.2 7.9 17.8 9.3 L10.1 17 C9.4 17.7 8.3 17.7 7.6 17 C6.9 16.3 6.9 15.2 7.6 14.5 L14.6 7.5</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">M4 7 L13 7 M17 7 L20 7 M4 17 L7 17 M11 17 L20 17 M15 5 L15 9 M9 15 L9 19</StreamGeometry>
        <StreamGeometry x:Key="IconSidebar">M4 5 L20 5 L20 19 L4 19 Z M9.5 5 L9.5 19</StreamGeometry>
        <StreamGeometry x:Key="IconPanel">M4 5 L20 5 L20 19 L4 19 Z M14.5 5 L14.5 19</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M11 4 C14.9 4 18 7.1 18 11 C18 14.9 14.9 18 11 18 C7.1 18 4 14.9 4 11 C4 7.1 7.1 4 11 4 Z M20 20 L16 16</StreamGeometry>
        <StreamGeometry x:Key="IconChevronDown">M6 9 L12 15 L18 9</StreamGeometry>
        <StreamGeometry x:Key="IconMore">M5 12 L5.01 12 M12 12 L12.01 12 M19 12 L19.01 12</StreamGeometry>
        <StreamGeometry x:Key="IconTrash">M4 7 L20 7 M10 11 L10 17 M14 11 L14 17 M6 7 L7 20 L17 20 L18 7 M9 7 L9 4 L15 4 L15 7</StreamGeometry>
        <StreamGeometry x:Key="IconClose">M6 6 L18 18 M18 6 L6 18</StreamGeometry>
        <StreamGeometry x:Key="IconTerminal">M5 7 L10 12 L5 17 M12 17 L19 17</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M3 6 L9 6 L11 8 L21 8 L21 19 L3 19 Z</StreamGeometry>
        <StreamGeometry x:Key="IconUndo">M9 14 L4 9 L9 4 M4 9 L15 9 C17.8 9 20 11.2 20 14 C20 16.8 17.8 19 15 19 L11 19</StreamGeometry>
        <StreamGeometry x:Key="IconRedo">M15 14 L20 9 L15 4 M20 9 L9 9 C6.2 9 4 11.2 4 14 C4 16.8 6.2 19 9 19 L13 19</StreamGeometry>
        <StreamGeometry x:Key="IconCopy">M9 9 L20 9 L20 20 L9 20 Z M5 15 L4 15 L4 4 L15 4 L15 5</StreamGeometry>
        <StreamGeometry x:Key="IconBranch">M6 3 L6 15 M18 9 C19.7 9 21 7.7 21 6 C21 4.3 19.7 3 18 3 C16.3 3 15 4.3 15 6 C15 7.7 16.3 9 18 9 Z M6 21 C7.7 21 9 19.7 9 18 C9 16.3 7.7 15 6 15 C4.3 15 3 16.3 3 18 C3 19.7 4.3 21 6 21 Z M18 9 C18 14 13 15 9 17</StreamGeometry>
        <StreamGeometry x:Key="IconRewind">M11 19 L4 12 L11 5 Z M20 19 L13 12 L20 5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconCommand">M9 6 C9 4.3 7.7 3 6 3 C4.3 3 3 4.3 3 6 C3 7.7 4.3 9 6 9 L18 9 C19.7 9 21 7.7 21 6 C21 4.3 19.7 3 18 3 C16.3 3 15 4.3 15 6 L15 18 C15 19.7 16.3 21 18 21 C19.7 21 21 19.7 21 18 C21 16.3 19.7 15 18 15 L6 15 C4.3 15 3 16.3 3 18 C3 19.7 4.3 21 6 21 C7.7 21 9 19.7 9 18 Z</StreamGeometry>
        <StreamGeometry x:Key="IconSpark">M12 3 L13.8 10.2 L21 12 L13.8 13.8 L12 21 L10.2 13.8 L3 12 L10.2 10.2 Z</StreamGeometry>
        <StreamGeometry x:Key="IconTool">M14 6 C15.5 4.5 18 4.5 19.5 6 L16.5 9 L15 9 L15 7.5 Z M15 9 L6 18 C5.4 18.6 4.4 18.6 3.8 18 C3.2 17.4 3.2 16.4 3.8 15.8 L12.8 6.8</StreamGeometry>
        <StreamGeometry x:Key="IconCheck">M5 12 L10 17 L19 8</StreamGeometry>
        <StreamGeometry x:Key="IconFile">M14 3 L6 3 L6 21 L18 21 L18 7 Z M14 3 L14 7 L18 7</StreamGeometry>
        <StreamGeometry x:Key="IconList">M9 6 L20 6 M9 12 L20 12 M9 18 L20 18 M4.5 6 L4.51 6 M4.5 12 L4.51 12 M4.5 18 L4.51 18</StreamGeometry>
        <StreamGeometry x:Key="IconPulse">M3 12 L7 12 L10 5 L14 19 L17 12 L21 12</StreamGeometry>
        <StreamGeometry x:Key="IconDiff">M12 4 L12 10 M9 7 L15 7 M9 17 L15 17 M5 3 L19 3 L19 21 L5 21 Z</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M20 11 C19.5 7 16.1 4 12 4 C9.3 4 6.9 5.3 5.5 7.4 M4 4 L4 8 L8 8 M4 13 C4.5 17 7.9 20 12 20 C14.7 20 17.1 18.7 18.5 16.6 M20 20 L20 16 L16 16</StreamGeometry>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
        <Setter Property="Background" Value="{StaticResource AppBackground}"/>
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style Selector="SelectableTextBlock">
        <Setter Property="SelectionBrush" Value="#3B4A6B"/>
    </Style>

    <!-- ===== Buttons ===== -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="#ECECEE"/>
        <Setter Property="Foreground" Value="#0E0E10"/>
        <Setter Property="BorderBrush" Value="#ECECEE"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#0E0E10"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="#2E2E33"/>
        <Setter Property="BorderBrush" Value="#2E2E33"/>
        <Setter Property="Foreground" Value="#71717A"/>
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHover}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#52525B"/>
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.icon:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#52525B"/>
    </Style>

    <Style Selector="Button.send">
        <Setter Property="Background" Value="#ECECEE"/>
        <Setter Property="Foreground" Value="#0E0E10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.send:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#0E0E10"/>
    </Style>
    <Style Selector="Button.send:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="#2E2E33"/>
        <Setter Property="Foreground" Value="#71717A"/>
    </Style>
    <Style Selector="Button.stop /template/ ContentPresenter">
        <Setter Property="Background" Value="#ECECEE"/>
    </Style>

    <Style Selector="Button.chip">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHover}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Button.list">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="Button.list:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Button.tab">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.tab.active">
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style Selector="Button.prompt-option">
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="Button.prompt-option:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHover}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    </Style>

    <!-- ===== Toggle ===== -->
    <Style Selector="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style Selector="ToggleButton:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
        <Setter Property="BorderBrush" Value="#5A3424"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
    </Style>

    <!-- ===== ComboBox (chip style inside the composer) ===== -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="ComboBox.chip">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>
    <Style Selector="ComboBox.chip:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{StaticResource SurfaceHover}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ===== Text input ===== -->
    <Style Selector="TextBox">
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
        <Setter Property="SelectionBrush" Value="#3B4A6B"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceSunken}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="TextBox /template/ TextBlock#PART_Watermark, TextBox /template/ TextBlock#PART_Placeholder">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource SurfaceSunken}"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceSunken}"/>
    </Style>
    <Style Selector="TextBox.bare, TextBox.bare:focus, TextBox.bare:pointerover">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2,4"/>
    </Style>
    <Style Selector="TextBox.bare /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement, TextBox.bare:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ===== Lists ===== -->
    <Style Selector="ListBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHover}"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHover}"/>
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Background" Value="{StaticResource BorderDefault}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <!-- ===== Text roles ===== -->
    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style Selector="TextBlock.kbd">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
    </Style>

    <!-- ===== Working indicator pulse ===== -->
    <Style Selector="Ellipse.pulse">
        <Style.Animations>
            <Animation Duration="0:0:1.2" IterationCount="Infinite" PlaybackDirection="Alternate">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.25"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
