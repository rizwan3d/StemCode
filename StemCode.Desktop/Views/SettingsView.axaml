<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StemCode.Desktop.ViewModels"
             xmlns:controls="using:StemCode.Desktop.Controls"
             x:Class="StemCode.Desktop.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel">

    <Border Background="#C0000000">
        <Border Background="{StaticResource AppBackground}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1"
                CornerRadius="14" Margin="40,32" MaxWidth="1080" MaxHeight="760" ClipToBounds="True"
                BoxShadow="0 24 64 0 #80000000">
            <Grid ColumnDefinitions="232,*">
                <!-- Navigation -->
                <Border Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" Margin="18,18,18,12"/>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Settings.Sections}" Margin="8,0,8,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingsSection">
                                        <Button Classes="list" Background="{Binding Background}" Margin="0,0,0,2" Click="Section_Click">
                                            <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground}" FontSize="13"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto" Margin="26,20,16,4">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Settings.SelectedSection.Title}" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Settings.SelectedSection.Description}" Classes="secondary" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button AutomationProperties.Name="Close (Esc)" Grid.Column="1" Classes="icon" ToolTip.Tip="Close (Esc)" Command="{Binding CloseSettingsCommand}" VerticalAlignment="Top">
                            <controls:Icon Data="{StaticResource IconClose}"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" IsVisible="{Binding Settings.HasWorkspaceHint}" Background="{StaticResource AccentSoft}"
                            CornerRadius="8" Padding="12,8" Margin="26,10,26,0">
                        <TextBlock Text="{Binding Settings.WorkspaceHint}" Foreground="{StaticResource Accent}" FontSize="12.5" TextWrapping="Wrap"/>
                    </Border>

                    <TextBox Grid.Row="2" IsVisible="{Binding Settings.HasArgument}" Margin="26,14,26,0"
                             PlaceholderText="{Binding Settings.SelectedSection.ArgumentLabel}"
                             Text="{Binding Settings.ArgumentText, Mode=TwoWay}" MinHeight="34" Padding="10,6"/>

                    <ItemsControl Grid.Row="3" ItemsSource="{Binding Settings.SelectedSection.Actions}" Margin="22,12,22,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsAction">
                                <Button Classes="secondary" Margin="4" Content="{Binding Label}" ToolTip.Tip="{Binding Tooltip}"
                                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Settings.RunActionCommand}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="4" Background="{StaticResource SurfaceBackground}" BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="10" Margin="26,8,26,10">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,Auto" Margin="14,10,14,0">
                                <TextBlock Text="{Binding Settings.OutputTitle}" Classes="label"/>
                                <TextBlock Grid.Column="1" Text="Working…" Classes="muted" IsVisible="{Binding Settings.IsBusy}"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" Padding="14,8,14,14">
                                <Grid>
                                    <controls:MarkdownMessageView SourceText="{Binding Settings.Output}" TextBrush="{StaticResource TextPrimary}"
                                                                  WorkspacePath="{Binding Settings.WorkspacePath}" IsVisible="{Binding Settings.HasOutput}"/>
                                    <TextBlock IsVisible="{Binding !Settings.HasOutput}" Classes="muted"
                                               Text="Choose an action above. Its output appears here."/>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="26,0,26,18">
                        <TextBox Text="{Binding Settings.CustomCommand, Mode=TwoWay}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                 PlaceholderText="/command arguments" MinHeight="34" Padding="10,6" KeyDown="CustomCommand_KeyDown"/>
                        <Button Grid.Column="1" Classes="primary" Content="Run" Margin="8,0,0,0" Command="{Binding Settings.RunCustomCommand}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
