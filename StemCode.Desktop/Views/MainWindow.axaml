<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StemCode.Desktop.ViewModels"
        xmlns:models="using:StemCode.Desktop.Models"
        xmlns:controls="using:StemCode.Desktop.Controls"
        xmlns:views="using:StemCode.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1360"
        d:DesignHeight="860"
        x:Class="StemCode.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/logo.ico"
        Width="1360"
        Height="880"
        MinWidth="760"
        MinHeight="560"
        Title="StemCode">

    <Grid>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <!-- Sidebar -->
            <views:SidebarView Width="268" IsVisible="{Binding IsSidebarOpen}"/>

            <!-- Center -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
                <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="10,8,10,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button AutomationProperties.Name="Show sidebar (Ctrl+B)" Classes="icon" Margin="0,0,6,0" IsVisible="{Binding !IsSidebarOpen}" ToolTip.Tip="Show sidebar (Ctrl+B)"
                                Command="{Binding ToggleSidebarCommand}">
                            <controls:Icon Data="{StaticResource IconSidebar}"/>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding Chat.SessionTitle}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis" Text="{Binding Chat.HeaderSubtitle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Border IsVisible="{Binding Chat.IsRunning}" Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="9,3" Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Classes="pulse" Width="6" Height="6" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Chat.StatusText}" Foreground="{StaticResource Accent}" FontSize="11.5"/>
                                </StackPanel>
                            </Border>
                            <Button AutomationProperties.Name="Undo last edit" Classes="icon" ToolTip.Tip="Undo last edit" Command="{Binding Chat.UndoCommand}">
                                <controls:Icon Data="{StaticResource IconUndo}"/>
                            </Button>
                            <Button AutomationProperties.Name="Command palette (Ctrl+K)" Classes="icon" ToolTip.Tip="Command palette (Ctrl+K)" Command="{Binding OpenPaletteCommand}">
                                <controls:Icon Data="{StaticResource IconCommand}" Size="15"/>
                            </Button>
                            <Button AutomationProperties.Name="Session actions" Classes="icon" ToolTip.Tip="Session actions">
                                <controls:Icon Data="{StaticResource IconMore}" StrokeThickness="3"/>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="New session" InputGesture="Ctrl+N" Command="{Binding NewSessionCommand}"/>
                                        <MenuItem Header="Fork from a message…" Command="{Binding Chat.RunSlashCommand}" CommandParameter="/fork"/>
                                        <MenuItem Header="Rewind…" Command="{Binding Chat.RunSlashCommand}" CommandParameter="/rewind"/>
                                        <MenuItem Header="Clone session" Command="{Binding Chat.RunSlashCommand}" CommandParameter="/clone"/>
                                        <MenuItem Header="Session tree" Command="{Binding Chat.RunSlashCommand}" CommandParameter="/tree"/>
                                        <MenuItem Header="Resume another session…" Command="{Binding Chat.RunSlashCommand}" CommandParameter="/resume"/>
                                        <Separator/>
                                        <MenuItem Header="Compact context" Command="{Binding Chat.RunSlashCommand}" CommandParameter="/compact"/>
                                        <MenuItem Header="Session info" Command="{Binding Chat.RunSlashCommand}" CommandParameter="/session"/>
                                        <MenuItem Header="Export">
                                            <MenuItem Header="JSON" Command="{Binding Chat.RunSlashCommand}" CommandParameter="/export json"/>
                                            <MenuItem Header="HTML" Command="{Binding Chat.RunSlashCommand}" CommandParameter="/export html"/>
                                            <MenuItem Header="Trajectory HTML" Command="{Binding Chat.RunSlashCommand}" CommandParameter="/export trajectory"/>
                                        </MenuItem>
                                        <MenuItem Header="Share as secret gist" Command="{Binding Chat.RunSlashCommand}" CommandParameter="/share"/>
                                        <Separator/>
                                        <MenuItem Header="Undo last edit" Command="{Binding Chat.UndoCommand}"/>
                                        <MenuItem Header="Redo edit" Command="{Binding Chat.RedoCommand}"/>
                                        <MenuItem Header="Clear view" Command="{Binding Chat.RunSlashCommand}" CommandParameter="/clear"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button AutomationProperties.Name="Changes, plan, terminals (Ctrl+J)" Classes="icon" ToolTip.Tip="Changes, plan, terminals (Ctrl+J)" Command="{Binding ToggleInspectorCommand}">
                                <controls:Icon Data="{StaticResource IconPanel}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <views:TranscriptView x:Name="Transcript" Grid.Row="1"/>
                <views:ComposerView x:Name="Composer" Grid.Row="2" IsVisible="{Binding ShowInlinePrompts}"/>
            </Grid>

            <views:InspectorView Grid.Column="3" Width="430" MinWidth="300" IsVisible="{Binding IsInspectorOpen}"/>
        </Grid>

        <!-- Settings overlay -->
        <views:SettingsView IsVisible="{Binding IsSettingsOpen}"/>

        <!-- Prompt raised while settings is open -->
        <Border IsVisible="{Binding ShowModalPrompt}" Background="#99000000">
            <Border Background="{StaticResource AppBackground}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="12"
                    MaxWidth="620" MaxHeight="620" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Chat.OnboardingTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Chat.OnboardingDescription}" Classes="secondary" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,12" IsVisible="{Binding Chat.HasActiveSelectionPrompt}">
                        <ItemsControl ItemsSource="{Binding Chat.ActiveSelectionPrompt.Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DesktopSelectionPromptOption">
                                    <Button Classes="prompt-option" Margin="0,0,0,6" Command="{Binding SelectCommand}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Label}" FontSize="13" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" Classes="muted" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBox Grid.Row="1" Margin="0,12" IsVisible="{Binding Chat.HasActiveTextPrompt}" VerticalAlignment="Top"
                             Text="{Binding Chat.ActiveTextPrompt.Value, Mode=TwoWay}" PasswordChar="{Binding Chat.ActiveTextPrompt.PasswordChar}"
                             MinHeight="36" Padding="10,7"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="ghost" Content="Cancel" IsVisible="{Binding Chat.CanCancelOnboardingSelectionPrompt}"
                                Command="{Binding Chat.ActiveSelectionPrompt.CancelCommand}"/>
                        <Button Classes="ghost" Content="Cancel" IsVisible="{Binding Chat.CanCancelOnboardingTextPrompt}"
                                Command="{Binding Chat.ActiveTextPrompt.CancelCommand}"/>
                        <Button Classes="primary" Content="Submit" IsVisible="{Binding Chat.HasActiveTextPrompt}"
                                Command="{Binding Chat.ActiveTextPrompt.SubmitCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Command palette -->
        <Border IsVisible="{Binding Palette.IsOpen}" Background="#80000000" PointerPressed="PaletteBackdrop_PointerPressed">
            <Border Background="{StaticResource SurfaceBackground}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1"
                    CornerRadius="12" Width="640" MaxHeight="520" Margin="0,90,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                    BoxShadow="0 24 64 0 #90000000" PointerPressed="PaletteBox_PointerPressed">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="Auto,*" Margin="14,6">
                        <controls:Icon Data="{StaticResource IconSearch}"/>
                        <TextBox x:Name="PaletteBox" Grid.Column="1" Classes="bare" FontSize="14" Margin="8,0,0,0"
                                 PlaceholderText="Search commands, settings, sessions, workspaces…"
                                 Text="{Binding Palette.Query, Mode=TwoWay}"/>
                    </Grid>
                    <ScrollViewer x:Name="PaletteScroll" Grid.Row="1" BorderBrush="{StaticResource BorderSubtle}">
                        <ItemsControl ItemsSource="{Binding Palette.Results}" Margin="6,0,6,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PaletteEntry">
                                    <Button Classes="list" Background="{Binding Background}" Command="{Binding ExecuteCommand}" Padding="10,6"
                                            Focusable="False">
                                        <Grid ColumnDefinitions="84,Auto,*,Auto">
                                            <TextBlock Text="{Binding Group}" Classes="kbd" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                                                       MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" Margin="12,0,8,0"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Shortcut}" Classes="kbd" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <!-- Provider onboarding -->
        <Border IsVisible="{Binding Chat.HasOnboardingOverlay}" Background="#E60E0E10">
            <Border Background="{StaticResource SurfaceBackground}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1"
                    CornerRadius="14" MaxWidth="900" MaxHeight="680" Margin="32" ClipToBounds="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid ColumnDefinitions="240,*">
                    <Border Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="22">
                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Spacing="12">
                                <Border Width="34" Height="34" CornerRadius="8" Background="#F4F4F5" HorizontalAlignment="Left" ClipToBounds="True">
                                    <Image Source="/Assets/logo.png" Width="34" Height="34" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="{Binding Chat.OnboardingHeading}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Chat.OnboardingBlurb}" Classes="secondary" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="14" VerticalAlignment="Bottom" IsVisible="{Binding Chat.IsDedicatedProviderSetup}">
                                <TextBlock Text="1  Provider" Classes="secondary"/>
                                <TextBlock Text="2  Credentials" Classes="secondary"/>
                                <TextBlock Text="3  Models" Classes="secondary"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="24,22,24,20">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding Chat.OnboardingStageText}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Chat.OnboardingTitle}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Chat.OnboardingDescription}" Classes="secondary" TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,16,0,12">
                            <ScrollViewer IsVisible="{Binding Chat.HasOnboardingSelectionPrompt}" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Chat.ActiveSelectionPrompt.Options}" Margin="0,0,8,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DesktopSelectionPromptOption">
                                            <StackPanel Spacing="6" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Section}" IsVisible="{Binding HasSection}" Classes="label"/>
                                                <Button Classes="prompt-option" Command="{Binding SelectCommand}" Padding="13,10">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" Classes="muted" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" IsVisible="{Binding IsDefault}" Background="#142016" CornerRadius="6" Padding="7,2"
                                                                VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <TextBlock Text="Default" Foreground="{StaticResource Success}" FontSize="10.5" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel IsVisible="{Binding Chat.HasOnboardingTextPrompt}" Spacing="10" VerticalAlignment="Top">
                                <TextBox x:Name="OnboardingTextBox" Text="{Binding Chat.ActiveTextPrompt.Value, Mode=TwoWay}"
                                         PasswordChar="{Binding Chat.ActiveTextPrompt.PasswordChar}" MinHeight="40" Padding="12,9"
                                         KeyDown="OnboardingTextBox_KeyDown"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button Classes="ghost" Content="Cancel" IsVisible="{Binding Chat.CanCancelOnboardingTextPrompt}"
                                            Command="{Binding Chat.ActiveTextPrompt.CancelCommand}"/>
                                    <Button Classes="primary" Content="Continue" Command="{Binding Chat.ActiveTextPrompt.SubmitCommand}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Chat.IsOnboardingWorking}" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                                <Ellipse Classes="pulse" Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="Validating provider and loading models…" Classes="secondary"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Chat.ActiveSelectionPrompt.CountdownText}" IsVisible="{Binding Chat.HasOnboardingCountdown}"
                                       Classes="kbd" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="ghost" Content="Cancel" IsVisible="{Binding Chat.CanCancelOnboardingSelectionPrompt}"
                                    Command="{Binding Chat.ActiveSelectionPrompt.CancelCommand}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
