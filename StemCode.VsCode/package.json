{
  "name": "stemcode-vscode",
  "displayName": "StemCode for VS Code",
  "description": "StemCode coding agent for VS Code: chat, edits, tools, and inline approvals over ACP.",
  "version": "0.1.0",
  "icon": "resources/logo.png",
  "license": "Apache-2.0",
  "homepage": "https://github.com/rizwan3d/StemCode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/rizwan3d/StemCode.git",
    "directory": "StemCode.VsCode"
  },
  "bugs": {
    "url": "https://github.com/rizwan3d/StemCode/issues"
  },
  "keywords": [
    "stemcode",
    "ai",
    "coding-agent",
    "acp",
    "agent-client-protocol"
  ],
  "files": [
    "dist/**",
    "media/**",
    "resources/**",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.txt"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "publisher": "growbitlab",
  "galleryBanner": {
    "color": "#101820",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:stemcode.openChat",
    "onCommand:stemcode.showTerminals",
    "onCommand:stemcode.voiceDictation",
    "onCommand:stemcode.voiceSetup",
    "onCommand:stemcode.voiceUpdate",
    "onView:stemcode.chatView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "stemcode",
          "title": "StemCode",
          "icon": "resources/logo.png"
        }
      ]
    },
    "views": {
      "stemcode": [
        {
          "type": "webview",
          "id": "stemcode.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "stemcode.start",
        "title": "Start",
        "category": "StemCode",
        "icon": "$(play)"
      },
      {
        "command": "stemcode.stop",
        "title": "Stop",
        "category": "StemCode",
        "icon": "$(debug-stop)"
      },
      {
        "command": "stemcode.restart",
        "title": "Restart",
        "category": "StemCode",
        "icon": "$(debug-restart)"
      },
      {
        "command": "stemcode.openChat",
        "title": "Open Chat",
        "icon": "$(comment-discussion)",
        "category": "StemCode"
      },
      {
        "command": "stemcode.newChat",
        "title": "New Chat",
        "icon": "$(add)",
        "category": "StemCode"
      },
      {
        "command": "stemcode.voiceDictation",
        "title": "Voice Dictation",
        "icon": "$(mic)",
        "category": "StemCode"
      },
      {
        "command": "stemcode.voiceSetup",
        "title": "Voice Setup",
        "category": "StemCode"
      },
      {
        "command": "stemcode.voiceUpdate",
        "title": "Update Voice Models",
        "category": "StemCode"
      },
      {
        "command": "stemcode.sendSelection",
        "title": "Send Selection",
        "category": "StemCode",
        "icon": "$(comment)"
      },
      {
        "command": "stemcode.sendCurrentFile",
        "title": "Send Current File",
        "category": "StemCode"
      },
      {
        "command": "stemcode.reviewCurrentFile",
        "title": "Review Current File",
        "category": "StemCode",
        "icon": "$(checklist)"
      },
      {
        "command": "stemcode.reviewGitDiff",
        "title": "Review Git Diff",
        "category": "StemCode",
        "icon": "$(git-compare)"
      },
      {
        "command": "stemcode.explainSelection",
        "title": "Explain Selection",
        "category": "StemCode",
        "icon": "$(question)"
      },
      {
        "command": "stemcode.planChanges",
        "title": "Plan Changes",
        "category": "StemCode"
      },
      {
        "command": "stemcode.applySuggestedChanges",
        "title": "Apply Suggested Changes",
        "category": "StemCode"
      },
      {
        "command": "stemcode.showTerminals",
        "title": "Show Background Terminals",
        "icon": "$(terminal)",
        "category": "StemCode"
      },
      {
        "command": "stemcode.openLogs",
        "title": "Open Logs",
        "category": "StemCode",
        "icon": "$(output)"
      },
      {
        "command": "stemcode.openSettings",
        "title": "Open Settings",
        "category": "StemCode",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "stemcode.openChat",
          "group": "navigation@90"
        }
      ],
      "editor/context": [
        {
          "submenu": "stemcode.editorContext",
          "group": "navigation@90"
        }
      ],
      "stemcode.editorContext": [
        {
          "command": "stemcode.explainSelection",
          "when": "editorHasSelection",
          "group": "1_selection@1"
        },
        {
          "command": "stemcode.sendSelection",
          "when": "editorHasSelection",
          "group": "1_selection@2"
        },
        {
          "command": "stemcode.sendCurrentFile",
          "group": "2_file@1"
        },
        {
          "command": "stemcode.reviewCurrentFile",
          "group": "2_file@2"
        },
        {
          "command": "stemcode.reviewGitDiff",
          "group": "3_git@1"
        }
      ],
      "view/title": [
        {
          "command": "stemcode.voiceDictation",
          "when": "view == stemcode.chatView",
          "group": "navigation@1"
        },
        {
          "command": "stemcode.showTerminals",
          "when": "view == stemcode.chatView",
          "group": "1_tools@1"
        },
        {
          "command": "stemcode.openSettings",
          "when": "view == stemcode.chatView",
          "group": "1_tools@2"
        },
        {
          "command": "stemcode.start",
          "when": "view == stemcode.chatView",
          "group": "2_process@1"
        },
        {
          "command": "stemcode.restart",
          "when": "view == stemcode.chatView",
          "group": "2_process@2"
        },
        {
          "command": "stemcode.stop",
          "when": "view == stemcode.chatView",
          "group": "2_process@3"
        },
        {
          "command": "stemcode.openLogs",
          "when": "view == stemcode.chatView",
          "group": "3_diagnostics@1"
        }
      ]
    },
    "configuration": {
      "title": "StemCode",
      "properties": {
        "stemcode.command": {
          "type": "string",
          "default": "stemcode",
          "description": "The command to run StemCode CLI."
        },
        "stemcode.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "--acp"
          ],
          "description": "Arguments to pass to the StemCode CLI."
        },
        "stemcode.workingDirectory": {
          "type": "string",
          "description": "The working directory for the StemCode CLI. Defaults to workspace root."
        },
        "stemcode.acpAuthenticationToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional ACP authentication token. Used when the ACP server returns `authMethods: [\"token\"]`. The extension checks VS Code SecretStorage key `stemcode.acpAuthToken` first, then this setting, then environment variable `STEMCODE_ACP_AUTH_TOKEN`."
        },
        "stemcode.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Whether to start StemCode automatically when VS Code starts."
        },
        "stemcode.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "The log level for the extension."
        }
      }
    },
    "submenus": [
      {
        "id": "stemcode.editorContext",
        "label": "StemCode"
      }
    ],
    "keybindings": [
      {
        "command": "stemcode.openChat",
        "key": "ctrl+shift+alt+s",
        "mac": "cmd+shift+alt+s"
      },
      {
        "command": "stemcode.sendSelection",
        "key": "ctrl+shift+alt+l",
        "mac": "cmd+shift+alt+l",
        "when": "editorTextFocus && editorHasSelection"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "typecheck:webview": "tsc --noEmit -p tsconfig.webview.json",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile-tests && npm run compile && npm run typecheck:webview && npm run lint",
    "test": "mocha --config .mocharc.json",
    "package:vsix": "vsce package --no-dependencies --githubBranch master",
    "publish:marketplace": "vsce publish --no-dependencies --githubBranch master",
    "test:integration": "npm run compile-tests && npm run compile && node ./out/test/runIntegration.js"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/jsdom": "^21.1.7",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "jsdom": "^24.1.3",
    "mocha": "^10.2.0",
    "ts-loader": "^9.4.3",
    "typescript": "^5.1.3",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.1"
  }
}
