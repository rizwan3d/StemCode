  </Commands>

  <CommandPlacements>
    <!-- StemCode Chat: View > Other Windows (above), View, Tools, and the top of both submenus. -->
    <CommandPlacement guid="guidStemCodeVsCmdSet" id="cmdidShowChatWindow" priority="0x0100">
      <Parent guid="guidStemCodeVsCmdSet" id="ViewMenuGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidStemCodeVsCmdSet" id="cmdidShowChatWindow" priority="0x0100">
      <Parent guid="guidStemCodeVsCmdSet" id="ToolsMenuGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidStemCodeVsCmdSet" id="cmdidShowChatWindow" priority="0x0100">
      <Parent guid="guidStemCodeVsCmdSet" id="ToolsChatGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidStemCodeVsCmdSet" id="cmdidShowChatWindow" priority="0x0100">
      <Parent guid="guidStemCodeVsCmdSet" id="EditorChatGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidStemCodeVsCmdSet" id="cmdidNewChat" priority="0x0101">
      <Parent guid="guidStemCodeVsCmdSet" id="ToolsChatGroup"/>
    </CommandPlacement>

    <!-- Editor commands also live under Tools > StemCode > Editor. -->
    <CommandPlacement guid="guidStemCodeVsCmdSet" id="cmdidExplainSelection" priority="0x0101">
      <Parent guid="guidStemCodeVsCmdSet" id="EditorMenuGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidStemCodeVsCmdSet" id="cmdidSendSelection" priority="0x0102">
      <Parent guid="guidStemCodeVsCmdSet" id="EditorMenuGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidStemCodeVsCmdSet" id="cmdidSendCurrentFile" priority="0x0104">
      <Parent guid="guidStemCodeVsCmdSet" id="EditorMenuGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidStemCodeVsCmdSet" id="cmdidReviewCurrentFile" priority="0x0105">
      <Parent guid="guidStemCodeVsCmdSet" id="EditorMenuGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidStemCodeVsCmdSet" id="cmdidReviewGitDiff" priority="0x0106">
      <Parent guid="guidStemCodeVsCmdSet" id="EditorMenuGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidStemCodeVsCmdSet" id="cmdidPlanChanges" priority="0x0107">
