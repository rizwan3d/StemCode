      <Button guid="guidStemCodeVsCmdSet" id="cmdidCheckForUpdates" priority="0x0101" type="Button">
        <Parent guid="guidStemCodeVsCmdSet" id="ToolsAboutGroup"/>
        <Strings><ButtonText>Check for CLI Updates</ButtonText><CommandName>StemCode.CheckForUpdates</CommandName></Strings>
      </Button>
      <Button guid="guidStemCodeVsCmdSet" id="cmdidVersion" priority="0x0102" type="Button">
        <Parent guid="guidStemCodeVsCmdSet" id="ToolsAboutGroup"/>
        <Strings><ButtonText>Show CLI Version</ButtonText><CommandName>StemCode.Version</CommandName></Strings>
      </Button>
