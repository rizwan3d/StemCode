  <KeyBindings>
    <!-- Same chords as the VS Code extension. -->
    <KeyBinding guid="guidStemCodeVsCmdSet" id="cmdidShowChatWindow" editor="guidVSStd97" key1="S" mod1="Control Shift Alt" />
    <KeyBinding guid="guidStemCodeVsCmdSet" id="cmdidSendSelection" editor="guidTextEditor" key1="L" mod1="Control Shift Alt" />
  </KeyBindings>

</CommandTable>
