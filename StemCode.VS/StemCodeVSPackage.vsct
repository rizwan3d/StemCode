        <Strings><ButtonText>Voice Setup...</ButtonText><CommandName>StemCode.VoiceSetup</CommandName></Strings>
      </Button>
      <Button guid="guidStemCodeVsCmdSet" id="cmdidVoiceUpdate" priority="0x0102" type="Button">
        <Parent guid="guidStemCodeVsCmdSet" id="VoiceMenuGroup"/>
        <Strings><ButtonText>Update Voice Models</ButtonText><CommandName>StemCode.VoiceUpdate</CommandName></Strings>
