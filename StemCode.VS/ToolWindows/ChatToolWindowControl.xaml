<UserControl x:Class="StemCode.VS.ToolWindows.ChatToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StemCode.VS.ToolWindows"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{x:Static local:ChatBrushes.Background}"
             Foreground="{x:Static local:ChatBrushes.Text}"
             TextElement.Foreground="{x:Static local:ChatBrushes.Text}"
             FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
             FontSize="13"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <local:WidthFractionConverter x:Key="WidthFractionConverter" />

        <!-- Base button: flat, themed, hover/pressed/focus states. Used by code-built buttons too. -->
        <Style x:Key="ChatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{x:Static local:ChatBrushes.Text}" />
            <Setter Property="BorderBrush" Value="{x:Static local:ChatBrushes.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{x:Static local:ChatBrushes.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{x:Static local:ChatBrushes.Pressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{x:Static local:ChatBrushes.InputFocus}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatPrimaryButton" TargetType="Button" BasedOn="{StaticResource ChatButton}">
            <Setter Property="Background" Value="{x:Static local:ChatBrushes.Accent}" />
            <Setter Property="Foreground" Value="{x:Static local:ChatBrushes.AccentText}" />
            <Setter Property="BorderBrush" Value="{x:Static local:ChatBrushes.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border x:Name="tint" Background="White" Opacity="0" CornerRadius="4" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tint" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="tint" Property="Opacity" Value="0.24" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatDangerButton" TargetType="Button" BasedOn="{StaticResource ChatButton}">
            <Setter Property="Foreground" Value="{x:Static local:ChatBrushes.Error}" />
            <Setter Property="BorderBrush" Value="{x:Static local:ChatBrushes.Error}" />
        </Style>

        <!-- Full-width list row (sessions, models, permission options, settings). -->
        <Style x:Key="ChatMenuButton" TargetType="Button" BasedOn="{StaticResource ChatButton}">
            <Setter Property="Background" Value="{x:Static local:ChatBrushes.Panel}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Borderless icon button for the header and composer. -->
        <Style x:Key="ChatIconButton" TargetType="Button" BasedOn="{StaticResource ChatButton}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{x:Static local:ChatBrushes.Dim}" />
            <Setter Property="FontFamily" Value="{x:Static local:ChatBrushes.Icons}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{x:Static local:ChatBrushes.Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small pill in the composer (@ context, model). -->
        <Style x:Key="ChatChipButton" TargetType="Button" BasedOn="{StaticResource ChatButton}">
            <Setter Property="Foreground" Value="{x:Static local:ChatBrushes.Dim}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{x:Static local:ChatBrushes.Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChatInput" TargetType="Control">
            <Setter Property="Background" Value="{x:Static local:ChatBrushes.InputBg}" />
            <Setter Property="Foreground" Value="{x:Static local:ChatBrushes.InputText}" />
            <Setter Property="BorderBrush" Value="{x:Static local:ChatBrushes.InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{x:Static local:ChatBrushes.InputFocus}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{x:Static local:ChatBrushes.Panel}" />
            <Setter Property="Foreground" Value="{x:Static local:ChatBrushes.Text}" />
            <Setter Property="BorderBrush" Value="{x:Static local:ChatBrushes.Border}" />
        </Style>

        <!-- UserMessage: right-aligned bubble. -->
        <DataTemplate DataType="{x:Type local:UserMessage}">
            <Border MaxWidth="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ActualWidth, Converter={StaticResource WidthFractionConverter}, ConverterParameter=0.86}"
                    HorizontalAlignment="Right"
                    Background="{x:Static local:ChatBrushes.UserBubble}"
                    BorderBrush="{x:Static local:ChatBrushes.Border}"
                    BorderThickness="1" CornerRadius="10" Padding="12,8"
                    Margin="0,4,0,12">
                <local:MarkdownPresenter Markdown="{Binding Text}" />
            </Border>
        </DataTemplate>

        <!-- AssistantMessage: full width, no chrome, like an editor document. -->
        <DataTemplate DataType="{x:Type local:AssistantMessage}">
            <Border MaxWidth="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ActualWidth, Converter={StaticResource WidthFractionConverter}, ConverterParameter=0.98}"
                    HorizontalAlignment="Left"
                    Background="Transparent" Padding="2,0,0,12">
                <local:MarkdownPresenter Markdown="{Binding Text}" />
            </Border>
        </DataTemplate>

        <!-- ReasoningMessage (collapsible). -->
        <DataTemplate DataType="{x:Type local:ReasoningMessage}">
            <Border MaxWidth="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ActualWidth, Converter={StaticResource WidthFractionConverter}, ConverterParameter=0.98}"
                    HorizontalAlignment="Left" Padding="0,0,0,8"
                    BorderBrush="{x:Static local:ChatBrushes.Border}" BorderThickness="2,0,0,0">
                <Expander Header="{Binding Summary}" Foreground="{x:Static local:ChatBrushes.Dim}"
                          FontSize="12" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                               local:SelectableTextBlock.IsEnabled="True"
                               Foreground="{x:Static local:ChatBrushes.Dim}" FontStyle="Italic"
                               LineHeight="18" FontSize="12" Margin="6,4,0,0" />
                </Expander>
            </Border>
        </DataTemplate>

        <!-- ToolMessage (plain). -->
        <DataTemplate DataType="{x:Type local:ToolMessage}">
            <Border MaxWidth="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ActualWidth, Converter={StaticResource WidthFractionConverter}, ConverterParameter=0.98}"
                    HorizontalAlignment="Left"
                    BorderBrush="{x:Static local:ChatBrushes.WarnFg}" BorderThickness="2,0,0,0"
                    Background="{x:Static local:ChatBrushes.Panel}" CornerRadius="0,4,4,0"
                    Padding="10,6" Margin="0,0,0,6">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                           local:SelectableTextBlock.IsEnabled="True"
                           Foreground="{x:Static local:ChatBrushes.Dim}"
                           FontFamily="{x:Static local:ChatBrushes.Mono}"
                           FontSize="12" LineHeight="18" />
            </Border>
        </DataTemplate>

        <!-- SystemMessage: quiet, centered notice. -->
        <DataTemplate DataType="{x:Type local:SystemMessage}">
            <Border MaxWidth="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ActualWidth, Converter={StaticResource WidthFractionConverter}, ConverterParameter=0.92}"
                    HorizontalAlignment="Center"
                    BorderBrush="{x:Static local:ChatBrushes.Border}" BorderThickness="1"
                    Background="{x:Static local:ChatBrushes.Panel}" CornerRadius="6"
                    Padding="10,6" Margin="0,0,0,8">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                           local:SelectableTextBlock.IsEnabled="True"
                           Foreground="{x:Static local:ChatBrushes.Dim}" FontSize="12"
                           TextAlignment="Center" />
            </Border>
        </DataTemplate>

        <!-- ToolCallStatusMessage (collapsible card with diff/output). -->
        <DataTemplate DataType="{x:Type local:ToolCallStatusMessage}">
            <Border MaxWidth="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ActualWidth, Converter={StaticResource WidthFractionConverter}, ConverterParameter=0.98}"
                    HorizontalAlignment="Stretch"
                    BorderBrush="{x:Static local:ChatBrushes.Border}" BorderThickness="1"
                    CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                    Background="{x:Static local:ChatBrushes.Panel}">
                <Expander IsExpanded="True" Foreground="{x:Static local:ChatBrushes.Text}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding HeaderText}" Foreground="{x:Static local:ChatBrushes.Text}"
                                       local:SelectableTextBlock.IsEnabled="True"
                                       FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MetaText}" Foreground="{x:Static local:ChatBrushes.Dim}"
                                       local:SelectableTextBlock.IsEnabled="True"
                                       FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <local:ToolCallContentPresenter Message="{Binding}" Margin="0,6,0,0" />
                </Expander>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: status, context usage, and the main actions. -->
        <Border Grid.Row="0" Padding="10,4,6,4"
                BorderBrush="{x:Static local:ChatBrushes.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" x:Name="StatusDot" Width="8" Height="8"
                         Fill="{x:Static local:ChatBrushes.Busy}" VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock Grid.Column="1" x:Name="StatusText" Text="Starting..."
                           Foreground="{x:Static local:ChatBrushes.Text}"
                           local:SelectableTextBlock.IsEnabled="True"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" x:Name="ContextText" Text=""
                           Foreground="{x:Static local:ChatBrushes.Dim}"
                           local:SelectableTextBlock.IsEnabled="True"
                           ToolTip="Context window used"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="NewChatButton" Style="{StaticResource ChatIconButton}"
                            Content="&#xE710;" ToolTip="New chat" Click="OnNewChatClick" />
                    <Button x:Name="SessionsButton" Style="{StaticResource ChatIconButton}"
                            Content="&#xE81C;" ToolTip="Sessions" Click="OnSessionsClick" />
                    <Button x:Name="SettingsButton" Style="{StaticResource ChatIconButton}"
                            Content="&#xE713;" ToolTip="Settings" Click="OnSettingsClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status banner: shown when the CLI can't start or exits unexpectedly. -->
        <Border Grid.Row="1" x:Name="Banner" Visibility="Collapsed"
                Margin="10,8,10,0" Padding="10,8"
                Background="{x:Static local:ChatBrushes.ErrorBg}"
                BorderBrush="{x:Static local:ChatBrushes.Error}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE783;" FontFamily="{x:Static local:ChatBrushes.Icons}"
                           Foreground="{x:Static local:ChatBrushes.Error}" FontSize="14"
                           VerticalAlignment="Top" Margin="0,1,8,0" />
                <TextBlock Grid.Column="1" x:Name="BannerText" Foreground="{x:Static local:ChatBrushes.Text}"
                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                           local:SelectableTextBlock.IsEnabled="True" />
                <Button Grid.Column="2" Style="{StaticResource ChatPrimaryButton}" Content="Retry"
                        Margin="8,0,0,0" ToolTip="Start StemCode again" Click="OnBannerRetryClick" />
                <Button Grid.Column="3" Style="{StaticResource ChatButton}" Content="Logs"
                        Margin="4,0,0,0" ToolTip="Open the StemCode log" Click="OnBannerLogsClick" />
            </Grid>
        </Border>

        <!-- Messages -->
        <ScrollViewer Grid.Row="2" x:Name="MessagesScrollViewer"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ScrollViewerStyleKey}}"
                      Background="Transparent"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      BorderThickness="0"
                      Padding="16,12,16,4"
                      PanningMode="VerticalOnly">
            <Grid>
                <StackPanel x:Name="EmptyStateText" HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="420" Margin="0,40,0,0">
                    <Image Source="pack://application:,,,/StemCode.VS;component/Resources/logo.png"
                           Width="44" Height="44" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="StemCode" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Ask about your code, plan a change, or let the agent edit and run tools. Every change waits for your approval."
                               Foreground="{x:Static local:ChatBrushes.Dim}" FontSize="12"
                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="19" Margin="0,0,0,16" />
                    <Border Background="{x:Static local:ChatBrushes.Panel}" BorderBrush="{x:Static local:ChatBrushes.Border}"
                            BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{x:Static local:ChatBrushes.Dim}" Margin="0,0,0,4">
                                <Run Text="/" FontFamily="{x:Static local:ChatBrushes.Mono}" Foreground="{x:Static local:ChatBrushes.Link}" />
                                <Run Text="  commands such as /init, /review, /models" />
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{x:Static local:ChatBrushes.Dim}" Margin="0,0,0,4">
                                <Run Text="@" FontFamily="{x:Static local:ChatBrushes.Mono}" Foreground="{x:Static local:ChatBrushes.Link}" />
                                <Run Text="  reference a file from the workspace" />
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{x:Static local:ChatBrushes.Dim}" TextWrapping="Wrap">
                                <Run Text="&#xE8A5;" FontFamily="{x:Static local:ChatBrushes.Icons}" Foreground="{x:Static local:ChatBrushes.Link}" />
                                <Run Text="  right-click in the editor → StemCode to send a selection, review a file, or review the git diff" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ItemsControl x:Name="MessagesList" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- Composer -->
        <Border Grid.Row="3" Padding="10,6,10,10">
            <StackPanel>
                <!-- Prompt queue: messages typed while a turn is running, drained in order. -->
                <ItemsControl x:Name="PromptQueueList" Margin="0,0,0,6" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{x:Static local:ChatBrushes.Panel}"
                                    BorderBrush="{x:Static local:ChatBrushes.Border}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,3" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Queued" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{x:Static local:ChatBrushes.Link}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{x:Static local:ChatBrushes.Dim}"
                                               FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="&#xE711;" Tag="{Binding}"
                                            Style="{StaticResource ChatIconButton}" FontSize="10"
                                            Width="20" Height="20" Margin="6,0,0,0"
                                            ToolTip="Remove from queue" Click="OnRemoveQueuedClick" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="ComposerBorder" BorderThickness="1" CornerRadius="8"
                        Background="{x:Static local:ChatBrushes.InputBg}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{x:Static local:ChatBrushes.InputBorder}" />
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{x:Static local:ChatBrushes.InputFocus}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="10,6,6,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Ask StemCode — / for commands, @ for files"
                                   Foreground="{x:Static local:ChatBrushes.Dim}" IsHitTestVisible="False"
                                   Margin="2,5,0,0" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=InputTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Grid.Row="0" x:Name="InputTextBox"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="40" MaxHeight="200"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{x:Static local:ChatBrushes.InputText}"
                                 CaretBrush="{x:Static local:ChatBrushes.InputText}"
                                 SelectionBrush="{x:Static local:ChatBrushes.Accent}"
                                 FontSize="13"
                                 Padding="0,4,0,0"
                                 VerticalContentAlignment="Top"
                                 PreviewKeyDown="OnInputKeyDown" />
                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="AddContextButton" Style="{StaticResource ChatChipButton}"
                                    ToolTip="Reference a file (/read)" Click="OnAddContextClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE723;" FontFamily="{x:Static local:ChatBrushes.Icons}"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Context" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" x:Name="ModelButton" Style="{StaticResource ChatChipButton}"
                                    ToolTip="Model, reasoning and thinking" Click="OnModelClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ModelText" Text="Model" MaxWidth="200"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70D;" FontFamily="{x:Static local:ChatBrushes.Icons}"
                                               FontSize="8" VerticalAlignment="Center" Margin="5,1,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="2" x:Name="MetricsText" Text=""
                                       Foreground="{x:Static local:ChatBrushes.Dim}" FontSize="11"
                                       local:SelectableTextBlock.IsEnabled="True"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="6,0,6,0" />
                            <!-- Microphone to dictate, square to stop listening. -->
                            <Button Grid.Column="3" x:Name="VoiceButton" Style="{StaticResource ChatIconButton}"
                                    Content="&#xE720;" Margin="0,0,4,0"
                                    ToolTip="Voice dictation (Ctrl+R)"
                                    AutomationProperties.Name="Voice dictation"
                                    Click="OnVoiceClick" />
                            <!-- One button: arrow to send, square to stop. -->
                            <Button Grid.Column="4" x:Name="SendButton"
                                    Content="&#xE724;"
                                    FontFamily="{x:Static local:ChatBrushes.Icons}"
                                    Width="28" Height="28"
                                    Background="{x:Static local:ChatBrushes.Accent}"
                                    Foreground="{x:Static local:ChatBrushes.AccentText}"
                                    FontSize="13"
                                    Cursor="Hand"
                                    ToolTip="Send (Enter)"
                                    Click="OnSendClick">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" />
                                            <!-- white tint so hover/press read on top of the accent/red background. -->
                                            <Border x:Name="Overlay" CornerRadius="6" Background="White" Opacity="0" />
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Overlay" Property="Opacity" Value="0.15" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Overlay" Property="Opacity" Value="0.3" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.35" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Slash-command / mention autocomplete -->
        <Popup x:Name="SuggestionPopup" Placement="Top" PlacementTarget="{Binding ElementName=ComposerBorder}"
               AllowsTransparency="True" StaysOpen="False" IsOpen="False" VerticalOffset="-4"
               MaxHeight="280" Width="{Binding ElementName=ComposerBorder, Path=ActualWidth}">
            <Border Background="{x:Static local:ChatBrushes.Panel}" BorderBrush="{x:Static local:ChatBrushes.Border}"
                    BorderThickness="1" CornerRadius="6" Padding="2">
                <ListBox x:Name="SuggestionList" Background="Transparent" BorderThickness="0"
                         Foreground="{x:Static local:ChatBrushes.Text}" MaxHeight="274"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonUp="OnSuggestionClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="8,4">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{x:Static local:ChatBrushes.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{x:Static local:ChatBrushes.Pressed}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Command}" FontFamily="{x:Static local:ChatBrushes.Mono}"
                                               Foreground="{x:Static local:ChatBrushes.Link}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Usage}" Foreground="{x:Static local:ChatBrushes.Dim}"
                                               FontFamily="{x:Static local:ChatBrushes.Mono}"
                                               FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Foreground="{x:Static local:ChatBrushes.Dim}"
                                           FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>

        <!-- Modal overlay for permission/text/model/session requests -->
        <Border Grid.RowSpan="4" x:Name="ModalOverlay" Visibility="Collapsed"
                Background="{x:Static local:ChatBrushes.Scrim}" Panel.ZIndex="100">
            <Border MaxWidth="560" MaxHeight="600" Margin="16"
                    Background="{x:Static local:ChatBrushes.Background}"
                    BorderBrush="{x:Static local:ChatBrushes.Border}"
                    BorderThickness="1" CornerRadius="8" Padding="18,16"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="ModalTitle"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{x:Static local:ChatBrushes.Text}" Text="" />
                    <TextBlock Grid.Row="1" x:Name="ModalDescription"
                               FontSize="12" Foreground="{x:Static local:ChatBrushes.Dim}"
                               Margin="0,6,0,12" TextWrapping="Wrap" />
                    <ScrollViewer Grid.Row="2" x:Name="ModalBodyScroll"
                                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ScrollViewerStyleKey}}"
                                  VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" MinWidth="360">
                        <StackPanel x:Name="ModalBodyPanel" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="3" x:Name="ModalActionsPanel"
                                Orientation="Horizontal" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
